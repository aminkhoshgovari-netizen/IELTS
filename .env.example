# ---- SERVER ONLY (set in Vercel > Settings > Environment Variables; locally copy to .env) ----
# Required
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional
ANTHROPIC_MODEL=claude-sonnet-4-6
RATE_LIMIT_MAX=30
# Only needed if the frontend is hosted on a different origin than the API (comma-separated):
# ALLOWED_ORIGINS=https://your-frontend.example.com
# Test/proxy override for the Anthropic base URL (leave unset in production):
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- FRONTEND (public – a URL only, never a key). Leave unset when frontend and API share one Vercel project. ----
# VITE_API_BASE_URL=https://your-api.vercel.app
